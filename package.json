{
  "name": "mdpad",
  "productName": "mdPad",
  "version": "0.1.3",
  "private": true,
  "description": "mdPad — a local-first, offline Markdown desktop editor.",
  "author": "mdPad",
  "license": "UNLICENSED",
  "homepage": "https://mdpad.olynors.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/armani0043/mdPad.git"
  },
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "pack:win": "npm run build && electron-builder --win --x64 --dir",
    "dist:win": "npm run build && electron-builder --win nsis portable --x64 --publish never",
    "release:win": "npm run build && electron-builder --win nsis portable --x64 --publish always",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "npm run format:check && npm run typecheck && npm run lint && npm test && npm run build"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.8",
    "@eslint/js": "^10.0.1",
    "@lezer/highlight": "^1.2.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^5.1.4",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.13",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.3.0",
    "happy-dom": "^20.11.2",
    "highlight.js": "^11.11.1",
    "lucide-react": "^1.31.0",
    "marked": "^18.0.9",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.10",
    "zustand": "^5.0.14"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
